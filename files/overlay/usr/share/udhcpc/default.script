#!/bin/sh
# Script appelé par udhcpc : applique la configuration reçue du serveur DHCP.
# Variables fournies par udhcpc : $interface $ip $mask $router $dns

case "$1" in
  deconfig)
    ip addr flush dev "$interface"
    ip link set "$interface" up
    ;;
  bound|renew)
    ip addr flush dev "$interface"
    ip addr add "$ip/${mask:-24}" dev "$interface"
    if [ -n "$router" ]; then
      ip route del default 2>/dev/null
      for r in $router; do
        ip route add default via "$r" dev "$interface"
        break
      done
    fi
    : > /etc/resolv.conf
    for d in $dns; do
      echo "nameserver $d" >> /etc/resolv.conf
    done
    echo "udhcpc: $interface -> $ip/${mask:-24} (passerelle ${router:-aucune})"
    ;;
esac
exit 0
